# VCPeer Book (Cal.com / cal.diy, MIT) — environment template.
# Copy to .env and fill in real values. Never commit the real .env file.

# ---------------------------------------------------------------------------
# DATABASE (Postgres container — see docker-compose.yml "postgres" service)
# ---------------------------------------------------------------------------
POSTGRES_USER=calcom
POSTGRES_PASSWORD=change-me-generate-a-real-password
POSTGRES_DB=calcom
# DATABASE_URL / DATABASE_DIRECT_URL are composed in docker-compose.yml from
# the three vars above — do not set them here unless you bypass compose.

# ---------------------------------------------------------------------------
# CORE / AUTH
# ---------------------------------------------------------------------------
# Local dev default. Production = https://book.vcpeer.com (task spec URL).
NEXT_PUBLIC_WEBAPP_URL=https://book.vcpeer.com
NEXT_PUBLIC_WEBSITE_URL=https://book.vcpeer.com
NEXTAUTH_URL=https://book.vcpeer.com
# For LOCAL testing only, override both of the above to http://localhost:3000
# in your real .env (see deploy/RUNBOOK.md "Local run" section).

ALLOWED_HOSTNAMES='"book.vcpeer.com","localhost:3000"'

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-openssl-rand--base64-32

# Generate with: openssl rand -base64 24 (must decode to 32 bytes for AES-256)
CALENDSO_ENCRYPTION_KEY=replace-with-openssl-rand--base64-24

CALCOM_TELEMETRY_DISABLED=1
CRON_API_KEY=replace-with-openssl-rand--hex-16

# ---------------------------------------------------------------------------
# E-MAIL — SMTP via Scribase Mail Studio (our own Resend-alternative, already
# live at mail.scribase.com — see memory scribase-mail-studio-resend-parity).
# Replace the placeholders with the real Scribase Mail API key/SMTP creds
# when this moves to the Oracle box. For LOCAL verification this task uses
# the Mailpit container instead (EMAIL_SERVER_HOST=mailpit, port 1025, no
# auth) — see deploy/RUNBOOK.md.
# ---------------------------------------------------------------------------
EMAIL_FROM=bookings@vcpeer.com
EMAIL_FROM_NAME=VCPeer
EMAIL_SERVER_HOST=smtp.scribase.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=replace-with-scribase-mail-smtp-user
EMAIL_SERVER_PASSWORD=replace-with-scribase-mail-smtp-password

# ---------------------------------------------------------------------------
# BRANDING (env-only — no source edits; see branding/README.md)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=VCPeer Book
NEXT_PUBLIC_SUPPORT_MAIL_ADDRESS=support@vcpeer.com
NEXT_PUBLIC_COMPANY_NAME=VCPeer

# Keep signups disabled on the production instance — this is an internal
# scheduling tool for the VCPeer team/org, not a public multi-tenant SaaS.
NEXT_PUBLIC_DISABLE_SIGNUP=true

# ---------------------------------------------------------------------------
# VCPEER VIDEO ROOM INTEGRATION
# ---------------------------------------------------------------------------
# Not a Cal.com env var — documented here so the room-link pattern lives
# next to the rest of the config. See branding/README.md "Video room
# integration" for the full explanation of why this is a per-event-type
# static "Link meeting" location rather than a per-booking dynamic one.
VCPEER_ROOM_BASE_URL=https://vcpeer.com/join
