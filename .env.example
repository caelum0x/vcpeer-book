# VCPeer Book (Cal.com / cal.diy, MIT) — environment template.
# Copy to .env and fill in real values. Never commit the real .env file.

# ---------------------------------------------------------------------------
# DATABASE (Postgres container — see docker-compose.yml "postgres" service)
# ---------------------------------------------------------------------------
POSTGRES_USER=calcom
POSTGRES_PASSWORD=change-me-generate-a-real-password
POSTGRES_DB=calcom
# DATABASE_URL / DATABASE_DIRECT_URL are composed in docker-compose.yml from
# the three vars above — do not set them here unless you bypass compose.

# ---------------------------------------------------------------------------
# CORE / AUTH
# ---------------------------------------------------------------------------
# Local dev default. Production = https://book.vcpeer.com (task spec URL).
NEXT_PUBLIC_WEBAPP_URL=https://book.vcpeer.com
NEXT_PUBLIC_WEBSITE_URL=https://book.vcpeer.com
NEXTAUTH_URL=https://book.vcpeer.com
# For LOCAL testing only, override both of the above to http://localhost:3000
# in your real .env (see deploy/RUNBOOK.md "Local run" section).

ALLOWED_HOSTNAMES='"book.vcpeer.com","localhost:3000"'

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-openssl-rand--base64-32

# Generate with: openssl rand -base64 24 (must decode to 32 bytes for AES-256)
CALENDSO_ENCRYPTION_KEY=replace-with-openssl-rand--base64-24

CALCOM_TELEMETRY_DISABLED=1

# Forces Node's process timezone to UTC — upstream's own .env.example default
# ("Force Node.js to use UTC as process timezone"). Added here because this
# deployment's calcom-cron sidecar (docker-compose.yml) and the Postgres
# backup cron (deploy/RUNBOOK.md section 5, 03:27 UTC) both assume UTC;
# leaving this unset relies on the container image's own default matching.
TZ=UTC

# Consumed by the "authorization" header cal.diy's /api/cron/* routes check
# for (bookingReminder, changeTimeZone, webhookTriggers, workflows/
# scheduleEmailReminders). The calcom-cron service in docker-compose.yml
# calls those endpoints on upstream's own schedule — set this to a real
# generated value or those crons 401 and silently never run.
CRON_API_KEY=replace-with-openssl-rand--hex-16

# ---------------------------------------------------------------------------
# E-MAIL — SMTP via Scribase Mail Studio (our own Resend-alternative, already
# live at mail.scribase.com — see memory scribase-mail-studio-resend-parity).
# Replace the placeholders with the real Scribase Mail API key/SMTP creds
# when this moves to the Oracle box. For LOCAL verification this task uses
# the Mailpit container instead (EMAIL_SERVER_HOST=mailpit, port 1025, no
# auth) — see deploy/RUNBOOK.md.
# ---------------------------------------------------------------------------
EMAIL_FROM=bookings@vcpeer.com
EMAIL_FROM_NAME=VCPeer
EMAIL_SERVER_HOST=smtp.scribase.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=replace-with-scribase-mail-smtp-user
EMAIL_SERVER_PASSWORD=replace-with-scribase-mail-smtp-password

# ---------------------------------------------------------------------------
# BRANDING (env-only — no source edits; see branding/README.md)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=VCPeer Book
NEXT_PUBLIC_SUPPORT_MAIL_ADDRESS=support@vcpeer.com
NEXT_PUBLIC_COMPANY_NAME=VCPeer

# Keep signups disabled on the production instance — this is an internal
# scheduling tool for the VCPeer team/org, not a public multi-tenant SaaS.
NEXT_PUBLIC_DISABLE_SIGNUP=true

# Self-hosters: upstream's own .env.example says to point these at your real
# privacy policy / terms URLs — they render as footer links on every public
# booking page attendees see. Privacy policy exists live today
# (https://vcpeer.com/privacy, confirmed in vcpeer/app/src/server.js's
# `app.get(['/privacy'], ...)` route) so it's filled in below. Terms is left
# blank on purpose: vcpeer has no terms-of-service page yet (checked —
# vcpeer/public/views/ has no terms.html and no matching server.js route).
# That's a real content gap in the `vcpeer` repo, not a config mistake here;
# fill this in once that page exists instead of pointing it at a 404.
NEXT_PUBLIC_WEBSITE_PRIVACY_POLICY_URL=https://vcpeer.com/privacy
NEXT_PUBLIC_WEBSITE_TERMS_URL=

# ---------------------------------------------------------------------------
# VCPEER VIDEO ROOM INTEGRATION
# ---------------------------------------------------------------------------
# NOT a Cal.com env var read by the app — Cal.com's Jitsi conferencing app
# keys (jitsiHost / jitsiPathPattern) are configured in-app, not via .env:
# Settings -> Admin -> Apps -> Conferencing -> Jitsi Video -> Edit keys ->
#   jitsiHost = https://vcpeer.com/join
#   jitsiPathPattern = (leave blank, defaults to "{uuid}")
# Documented here as the source of truth for that value so it lives next to
# the rest of the config. This gives every booking a fresh, unique room
# (https://vcpeer.com/join/<uuid>), generated server-side by Cal.com's own
# Jitsi app at booking time — not a shared static link. See
# branding/README.md "Video room integration" for the full verification
# (two separate bookings, two different room links, confirmed in both the
# confirmation page and the Mailpit-captured emails) and why the earlier
# static "Link meeting" approach was replaced (it reused one room across
# every booking of an event type — a privacy bug, not just a limitation).
VCPEER_ROOM_BASE_URL=https://vcpeer.com/join
